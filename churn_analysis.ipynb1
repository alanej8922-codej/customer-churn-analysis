   "source": [
    "## Pivot table"
   ],
   "id": "cell-084"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Pivot Table\n",
    "\n",
    "pd.pivot_table(\n",
    "    df_visual,\n",
    "    index='plan_type',\n",
    "    values='churn_flag',\n",
    "    aggfunc = 'mean'\n",
    ")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-085"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# pivot table using multiple cols and agg type\n",
    "\n",
    "pd.pivot_table(\n",
    "    df_visual,\n",
    "    index='plan_type',\n",
    "    values=['monthly_charges', 'customerid', 'churn_flag'],\n",
    "    aggfunc = {\n",
    "        'monthly_charges' : 'sum',\n",
    "        'customerid' : 'nunique',\n",
    "        'churn_flag' : 'mean'\n",
    "    }\n",
    ")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-086"
  },
