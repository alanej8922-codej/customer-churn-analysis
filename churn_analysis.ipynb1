  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# country and state - unique value pair\n",
    "\n",
    "# Creating state \u2192 country map from non-null rows\n",
    "state_country_mapping = df_db_customer.dropna(subset=['country']).set_index('state')['country'].to_dict()\n",
    "\n",
    "# Fill the missing country using State\n",
    "df_db_customer['country'] = df_db_customer['country'].fillna(df_db_customer['state'].map(state_country_mapping))"
   ],
   "execution_count": null,
   "outputs": [],
