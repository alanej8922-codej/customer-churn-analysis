  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Feature Engineering & Data Analysis\n",
    "\n",
    "#### Create a new col"
   ],
   "id": "cell-033"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# create a new col using existing col - churn flag\n",
    "\n",
    "# Customer is churned if cancellation_date is not null\n",
    "df_db_subscription['churn_flag'] = np.where(df_db_subscription['cancellation_date'].notna(), 1, 0)\n",
    "df_db_subscription.head()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-034"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Merge Dataframes - JOINs"
   ],
   "id": "cell-035"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# first fix support table duplicates then merge\n",
    "# Note: while merging df's always check the shape before and after\n",
    "df = (df_db_subscription\n",
    "            .merge(df_db_customer, on = 'customerid', how= 'left')\n",
    "            .merge(df_db_support, on = 'customerid', how= 'left') )"
   ],
   "execution_count": null,
