  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Heatmap (Correlation Matrix)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-069"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# encoding - convert str to numeric so that we can find corr between features\n",
    "df_visual.columns"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-070"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "df_visual[['plan_type', 'contract_type', 'churn_score', 'churn_flag', 'churn_risk', 'escalations']].head()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-071"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# remove warnings\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-072"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# incorrect method of encoding - as numbers are not assigned based on priority\n",
    "df_encoded = df_visual[['plan_type', 'contract_type', 'churn_score', 'churn_flag', 'churn_risk', 'escalations']]\n",
    "\n",
    "categorial_cols = ['plan_type', 'contract_type', 'churn_risk']\n",
    "\n",
    "for col in categorial_cols:\n",
    "    df_encoded[col] = df_encoded[col].astype('category').cat.codes"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-073"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Heatmap (correlation matrix)\n",
    "\n",
    "sns.heatmap(df_encoded.corr(), annot=True)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-074"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "print('plan_type :', df_visual['plan_type'].unique())\n",
    "print('contract_type :', df_visual['contract_type'].unique())\n",
    "print('churn_risk :', df_visual['churn_risk'].unique())"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-075"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Correct method of encoding - based on priority\n",
    "df_encoded = df_visual[['plan_type', 'contract_type', 'churn_score', 'churn_flag', 'churn_risk', 'escalations']]\n",
    "\n",
    "order_mappings = {\n",
    "    'plan_type' : ['Basic', 'Standard', 'Premium'],\n",
    "    'contract_type' : ['Monthly', 'Annual'],\n",
    "    'churn_risk': ['low', 'med', 'high']\n",
    "    }\n",
    "\n",
    "for col, order in order_mappings.items():\n",
    "    df_encoded[col] = pd.Categorical(df_encoded[col].astype('category'), categories=order, ordered=True).codes"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-076"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "df_visual[['plan_type', 'contract_type', 'churn_score', 'churn_flag', 'churn_risk', 'escalations']].head()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-077"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "df_encoded.head()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-078"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Heatmap (correlation matrix)\n",
    "sns.heatmap(df_encoded.corr(), annot=True)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-079"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Heatmap Using Matplotlib - difficult to plot it\n",
    "\n",
    "corr_matrix = df_encoded.corr() # Correlation matrix\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6)) # Create figure\n",
    "\n",
    "cax = ax.imshow(corr_matrix, cmap='coolwarm') # Heatmap\n",
    "\n",
    "fig.colorbar(cax) # Add colorbar\n",
    "\n",
    "# Axis labels\n",
    "ax.set_xticks(np.arange(len(corr_matrix.columns)))\n",
    "ax.set_yticks(np.arange(len(corr_matrix.columns)))\n",
    "\n",
    "ax.set_xticklabels(corr_matrix.columns, rotation=45)\n",
    "ax.set_yticklabels(corr_matrix.columns)\n",
    "\n",
    "# Annotate values inside cells\n",
    "for i in range(len(corr_matrix.columns)):\n",
    "    for j in range(len(corr_matrix.columns)):\n",
    "        ax.text(\n",
    "            j,\n",
    "            i,\n",
    "            f\"{corr_matrix.iloc[i, j]:.2f}\",\n",
    "            ha='center',\n",
    "            va='center'\n",
    "        )\n",
    "\n",
    "plt.title('Correlation Heatmap') # Title\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-080"
  },
