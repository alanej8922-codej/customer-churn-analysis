  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Analysis"
   ],
   "id": "cell-048"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 1. Churn Rate"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-049"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "churn_rate = df['churn_flag'].mean()*100\n",
    "print(\"Churn Rate = \", round(churn_rate,2), \"%\")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-050"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 2. Retenion Rate\n",
    "retention_rate = 100 - churn_rate\n",
    "print(\"Retention Rate = \", round(retention_rate,2), \"%\")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-051"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 3. Churn by Plan type\n",
    "churn_by_plan = (df.groupby('plan_type')['churn_flag'].mean().mul(100).round(2).reset_index(name='churn_rate_pct'))\n",
    "print(churn_by_plan)"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-052"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 4 a. Churn by state + sum(revenue) & count of users  -- home work **\n",
    "# 4 b. Churn by subscription type + sum(revenue) & count of users   -- home work **"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-053"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 5. ARPU - Avg Revenue per user (active customers only)\n",
    "active = df[df['churn_flag'] == 0]\n",
    "arpu = active['monthly_charges'].sum() / active['customerid'].nunique()\n",
    "print('ARPU = ', round(arpu, 2))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-054"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# homework - calculate customer age"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-055"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 6. Avg Customer Tenure\n",
    "# count of days users has used our service : cancellation date else current date\n",
    "today = pd.Timestamp.today()\n",
    "\n",
    "df['tenure_days'] = np.where(\n",
    "        df['cancellation_date'].notna(),\n",
    "\n",
    "    (df['cancellation_date'] - df['subscription_start_date']).dt.days,\n",
    "\n",
    "    (today - df['subscription_start_date']).dt.days\n",
    ")\n",
    "\n",
    "avg_tenure = df['tenure_days'].mean()\n",
    "print(\"Avg Tenure (Days) = \", round(avg_tenure, 0))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-056"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 7. Revenue at risk - monthly revenue from high-risk customers (churn_score > 70)\n",
    "revenue_at_risk = df.loc[df['churn_score'] > 70, 'monthly_charges'].sum()\n",
    "print('Revenue at Risk =', round(revenue_at_risk, 2))\n",
    "\n",
    "# Revenue lost from customers who already churned\n",
    "revenue_lost = df.loc[df['churn_flag'] == 1, 'monthly_charges'].sum()\n",
    "print('Revenue Lost to Churn =', round(revenue_lost, 2))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-057"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 8. Esclation Rate\n",
    "escalation_rate = (df['escalations']=='Y').mean()*100\n",
    "print(\"Esclation Rate = \", round(escalation_rate, 2), \"%\")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-058"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 9. Avg Complaint Per User\n",
    "avg_complaints = df['complaint_count'].sum() / df['customerid'].nunique()\n",
    "print(\"Avg Compliants Per User = \", round(avg_complaints, 2))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-059"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 10. Correlation Esclation vs Churn\n",
    "df['escalations'] = np.where(df['escalations'] == 'Y', 1, 0) # encoding string to int type\n",
    "corr_df = df[['escalations', 'churn_flag']].dropna()\n",
    "\n",
    "correlation = corr_df['escalations'].corr(df['churn_flag'])\n",
    "print(\"Correlation between esclation vs churn is = \", round(correlation,2))"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-060"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 11. Create a column using existing col - Churn risk\n",
    "conditions = [\n",
    "        (df['churn_score'] < 50),\n",
    "        (df['churn_score'] >= 50) & (df['churn_score'] < 70),\n",
    "        (df['churn_score'] >= 70)\n",
    "]\n",
    "\n",
    "choices = ['low', 'med', 'high']\n",
    "\n",
    "df['churn_risk'] = np.select(conditions, choices, default='unkown')"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-061"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Visualization using Matplotlib"
   ],
   "id": "cell-062"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# best practice to create a copy then work on it\n",
    "df_visual = df.copy()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-063"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "df_visual.columns"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-064"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 4.1 Monthly Churn Trend (Time Series KPI)\n",
    "\n",
    "df_visual['cancellation_month'] = df_visual['cancellation_date'].dt.to_period('M')\n",
    "\n",
    "churn_trend = df_visual[df_visual['churn_flag'] == 1].groupby('cancellation_month').size()\n",
    "\n",
    "plt.figure(figsize=(8,3))\n",
    "plt.plot(churn_trend.index.astype(str), churn_trend.values,  color='green', marker='o', linestyle='dashed',  linewidth=2, markersize=12)\n",
    "\n",
    "plt.title('Monthly Churn Trend')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Churned Customers')\n",
    "plt.show()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-065"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 4.2 Churn Rate by Plan type\n",
    "churn_plan = df_visual.groupby('plan_type')['churn_flag'].mean() * 100\n",
    "\n",
    "# colors = ['yellow', 'purple', 'blue']\n",
    "colors = plt.cm.Set2(np.linspace(0, 1, len(churn_plan)))\n",
    "\n",
    "plt.figure(figsize=(7,4))\n",
    "plt.bar(churn_plan.index, churn_plan.values, color = colors)\n",
    "\n",
    "plt.title('Churn Rate by Plan Type')\n",
    "plt.xlabel('Plan Type')\n",
    "plt.ylabel('Churn Rate (%)')\n",
    "plt.show()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-066"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 4.3 Churn by States\n",
    "churn_plan = df_visual.groupby('state')['churn_flag'].mean() * 100\n",
    "\n",
    "# colors = ['yellow', 'purple', 'blue']\n",
    "colors = plt.cm.Set2(np.linspace(0, 1, len(churn_plan)))\n",
    "\n",
    "plt.figure(figsize=(12,4))\n",
    "plt.bar(churn_plan.index, churn_plan.values, color = colors)\n",
    "\n",
    "plt.title('Churn Rate by State')\n",
    "plt.xlabel('State')\n",
    "plt.ylabel('Churn Rate (%)')\n",
    "plt.xticks(rotation=45)\n",
    "plt.show()"
   ],
   "execution_count": null,
