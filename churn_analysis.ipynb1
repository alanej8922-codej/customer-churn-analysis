  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# e. fix missing values - country\n",
    "\n",
    "# df_db_customer['country'].isna().sum()\n",
    "df_db_customer[df_db_customer['country'].isna()]"
   ],
   "execution_count": null,
