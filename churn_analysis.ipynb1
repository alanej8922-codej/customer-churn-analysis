   "source": [
    "## Churn Analysis and Customer Intelligence"
   ],
   "id": "cell-000"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Churn Analysis and Customer Intelligence"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-001"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# import libraries\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import sqlite3"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-002"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import database / data  "
   ],
   "id": "cell-003"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# NOTE:\n",
    "# If you encounter any issues importing the customer_churn.db file,\n",
    "# run the code below to create the database locally from the provided Excel file OR, can directly import data & start working.\n",
    "\n",
    "# Otherwise, skip this step and proceed to the next section: Data Import\n",
    "\n",
    "# Excel file path\n",
    "excel_file = 'customer_churn_data_raw.xlsx'\n",
    "\n",
    "# Create SQLite database connection\n",
    "conn = sqlite3.connect('customer_churn.db')\n",
    "\n",
    "# Read all sheet names from Excel file\n",
    "excel_data = pd.ExcelFile(excel_file)\n",
    "\n",
    "# Loop through each sheet and store as separate table\n",
    "for sheet in excel_data.sheet_names:\n",
    "    df = pd.read_excel(excel_file, sheet_name=sheet) # Read sheet into dataframe\n",
    "    # Write dataframe to SQLite table\n",
    "    df.to_sql(\n",
    "        name=sheet,          # Table name = Sheet name\n",
    "        con=conn,\n",
    "        if_exists='replace', # Replace table if already exists\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "# Close connection\n",
    "conn.close()\n",
    "\n",
    "print(\"All sheets successfully converted into SQLite tables.\")"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-004"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Data Import: db file to pandas, storing each table to a separate df\n",
    "\n",
    "# Connect to SQLite database\n",
    "conn = sqlite3.connect('customer_churn.db')\n",
    "\n",
    "# sql query to Get all table names\n",
    "sql_query = \"\"\"\n",
    "        SELECT name\n",
    "        FROM sqlite_master\n",
    "        WHERE type='table';\n",
    "\"\"\"\n",
    "\n",
    "# read sql query in pandas\n",
    "tables = pd.read_sql(sql_query, conn)\n",
    "\n",
    "# create dataframe for each table\n",
    "for table_name in tables['name']:\n",
    "    df = pd.read_sql(f\"SELECT * FROM {table_name}\", conn) # Read table into dataframe\n",
    "    globals()[f\"df_{table_name}\"] = df                    # Create dynamic dataframe name\n",
    "    print(f\"Created dataframe: df_{table_name}\")\n",
    "\n",
    "# Close connection\n",
    "conn.close()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-005"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Print table names and column names\n",
    "conn = sqlite3.connect('customer_churn.db')\n",
    "\n",
    "for table_name in tables['name']:\n",
    "    print(f\"\\nTable Name: {table_name}\")\n",
    "    # Get column information\n",
    "    columns_query = f\"PRAGMA table_info({table_name});\"\n",
    "    columns = pd.read_sql(columns_query, conn)\n",
    "    print(\"Columns:\")\n",
    "    print(columns['name'].tolist())\n",
    "\n",
    "# Close connection\n",
    "conn.close()"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-006"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# PRAGMA is a special command in SQLite used to:\n",
    "# inspect db information, control db settings, retrieve metadata about tables"
   ],
   "execution_count": null,
   "outputs": [],
   "id": "cell-007"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
